# Public origin used for canonical URLs, Open Graph tags, robots.txt and the
# sitemap (no trailing slash). Falls back to Vercel's production domain.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only, never expose it to the browser. Required for the per-title cache
# tables (ratings, streaming links, Wikidata facts, franchises), which have RLS
# on and no anon access. Project Settings > API Keys > service_role / secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# TMDB
TMDB_API_KEY=your-tmdb-api-key

# GNews (optional - for region-specific movie news headlines)
GNEWS_API_KEY=

# The Guardian (optional - for film-section movie news, merged with GNews)
# Free non-commercial key from https://open-platform.theguardian.com/access/
# (500 requests/day, 1 request/second)
GUARDIAN_API_KEY=

# MDBList (optional - for IMDb / Rotten Tomatoes / Metacritic ratings on title pages)
# Free key from https://mdblist.com/preferences (1,000 requests/day)
MDBLIST_API_KEY=

# Streaming Availability by Movie of the Night (optional - direct links to the
# title on each streaming service, with rent/buy prices, on title pages)
# Key from https://www.movieofthenight.com/about/api (free: 1,000 requests/month)
MOTN_API_KEY=

# YouTube Data API v3 (optional - for the top comment beside the videos player)
# Key from https://console.cloud.google.com/apis/credentials with "YouTube Data
# API v3" enabled (free: 10,000 units/day; each comment lookup costs 1)
YOUTUBE_API_KEY=

# Hotjar (optional - for heatmaps, session recordings, feedback)
NEXT_PUBLIC_HOTJAR_ID=

# Cloudflare Turnstile (optional - invisible human check that gates the
# per-title API routes, so scrapers can't trigger Wikidata, Supabase, YouTube
# or Streaming Availability lookups). Free; create a widget for your domain at
# https://dash.cloudflare.com/?to=/:account/turnstile (Widget mode: Invisible).
# For local testing, Cloudflare's always-pass test keys work:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Without both, the check is off and the gated routes answer everyone.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
